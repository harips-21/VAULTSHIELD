generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum PermissionLevel {
  OWNER
  EDITOR
  VIEWER
}

enum ActivityAction {
  VIEWED
  EDITED
  SHARED
  DOWNLOADED
  DELETED
  RESTORED
  VERSION_RESTORED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships       OrganizationMembership[]
  createdFolders    Folder[]                 @relation("CreatedFolders")
  ownedDocuments    Document[]               @relation("OwnedDocuments")
  uploadedVersions  DocumentVersion[]
  documentShares    DocumentShare[]
  folderShares      FolderShare[]
  activityLogs      ActivityLog[]
  comments          Comment[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  OrganizationMembership[]
  folders      Folder[]
  documents    Document[]
  activityLogs ActivityLog[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now()) @map("joined_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_memberships")
}

model Folder {
  id              String    @id @default(uuid())
  name            String
  organizationId  String    @map("organization_id")
  createdByUserId String    @map("created_by_user_id")
  parentFolderId  String?   @map("parent_folder_id")
  isTrashed       Boolean   @default(false) @map("is_trashed")
  trashedAt       DateTime? @map("trashed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("CreatedFolders", fields: [createdByUserId], references: [id])
  parentFolder Folder?       @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders Folder[]      @relation("FolderHierarchy")
  documents    Document[]
  shares       FolderShare[]
  activityLogs ActivityLog[]

  @@map("folders")
}

model Document {
  id               String    @id @default(uuid())
  name             String
  mimeType         String    @map("mime_type")
  fileSize         BigInt    @map("file_size")
  organizationId   String    @map("organization_id")
  folderId         String?   @map("folder_id")
  ownerId          String    @map("owner_id")
  tags             String[]  @default([])
  isTrashed        Boolean   @default(false) @map("is_trashed")
  trashedAt        DateTime? @map("trashed_at")
  currentVersionId String?   @map("current_version_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  owner        User              @relation("OwnedDocuments", fields: [ownerId], references: [id])
  versions     DocumentVersion[]
  shares       DocumentShare[]
  comments     Comment[]
  activityLogs ActivityLog[]

  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String   @map("document_id")
  versionNumber    Int      @map("version_number")
  storagePath      String   @map("storage_path")
  checksumSha256   String   @map("checksum_sha256")
  fileSize         BigInt   @map("file_size")
  encryptedDek     String   @map("encrypted_dek")
  iv               String   @map("iv")
  authTag          String   @map("auth_tag")
  uploadedByUserId String   @map("uploaded_by_user_id")
  changeSummary    String?  @map("change_summary")
  createdAt        DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedByUserId], references: [id])

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentShare {
  id               String          @id @default(uuid())
  documentId       String          @map("document_id")
  sharedWithUserId String?         @map("shared_with_user_id")
  permission       PermissionLevel @default(VIEWER)
  shareToken       String?         @unique @map("share_token")
  passwordHash     String?         @map("password_hash")
  expiresAt        DateTime?       @map("expires_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWith User?    @relation(fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@map("document_shares")
}

model FolderShare {
  id               String          @id @default(uuid())
  folderId         String          @map("folder_id")
  sharedWithUserId String?         @map("shared_with_user_id")
  permission       PermissionLevel @default(VIEWER)
  shareToken       String?         @unique @map("share_token")
  passwordHash     String?         @map("password_hash")
  expiresAt        DateTime?       @map("expires_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  folder     Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  sharedWith User?  @relation(fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@map("folder_shares")
}

model ActivityLog {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  documentId     String?        @map("document_id")
  folderId       String?        @map("folder_id")
  action         ActivityAction
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model Comment {
  id              String   @id @default(uuid())
  documentId      String   @map("document_id")
  userId          String   @map("user_id")
  parentCommentId String?  @map("parent_comment_id")
  content         String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@map("comments")
}
