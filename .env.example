# Backend Environment Variables
NODE_ENV=development
PORT=5000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=securedocdb
DATABASE_URL=postgresql://postgres:replace_with_generated_password@localhost:5432/securedocdb?schema=public
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Keep secret!)
JWT_SECRET=
JWT_REFRESH_SECRET=
MASTER_ENCRYPTION_KEY=

# File Storage Config
STORAGE_DIR=./storage/encrypted
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=50

# Frontend URL
CLIENT_URL=http://localhost:3000
