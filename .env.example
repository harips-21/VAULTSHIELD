# Backend Environment Variables
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/securedocdb?schema=public
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Keep secret!)
JWT_SECRET=super-secret-jwt-access-key-2026
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-2026
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# File Storage Config
STORAGE_DIR=./storage/encrypted
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=50

# Frontend URL
CLIENT_URL=http://localhost:3000
